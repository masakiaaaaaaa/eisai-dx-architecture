# ==============================================================================
# EISAI DX ARCHITECTURE SPEC - Environment Variables Template
# ==============================================================================

# Database Connection (PostgreSQL or Supabase)
# For local development with PostgreSQL, replace with your local credentials:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eisai_dx?schema=public"

# LINE Messaging API Credentials (Mock / Optional for local testing)
LINE_CHANNEL_ACCESS_TOKEN="mock_line_channel_access_token"
LINE_CHANNEL_SECRET="mock_line_channel_secret"

# Cron Secret for Weekly Scheduled Jobs
CRON_SECRET="local_cron_secret_key"

# Environment
NODE_ENV="development"
